{
  // Minimal Waybar config. To test, run:
  //
  //     waybar -c test/data/config.jsonc
  "layer": "top",
  "position": "top",
  "modules-left": [],
  "modules-center": ["custom/tomato-slicer"],
  "modules-right": [],

  "custom/tomato-slicer": {
    "exec": "./result/bin/tomato-slicer",
    "on-click": "pkill -SIGUSR1 -f tomato-slicer",
    "return-type": "json"
  }
}
