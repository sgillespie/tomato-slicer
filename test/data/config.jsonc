{
  // Minimal Waybar config. To test, run:
  //
  //     waybar -c test/data/config.jsonc
  "layer": "top",
  "position": "top",
  "modules-left": [],
  "modules-center": ["custom/tomato-slicer"],
  "modules-right": [],

  "custom/tomato-slicer": {
    "format": "{icon} {text}",
    "format-icons": {
      "ready": "󰚭",
      "running": "󰔟",
      "paused": "󱦠",
      "done": "󱦟"
    },
    "exec": "./result/bin/tomato-slicer -d 10",
    "on-click": "pkill -SIGUSR1 -f tomato-slicer",
    "on-click-right": "pkill -SIGUSR2 -f tomato-slicer",
    "return-type": "json"
  }
}
